<Project>
  <!-- Propriétés communes à tous les projets de la solution -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Permet de compiler les projets "-windows" (WPF, Win32) depuis Linux/macOS (CI, conteneurs) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Version par défaut ; la CI la remplace par celle du tag git (vX.Y.Z) -->
    <Version>1.5.0</Version>
    <Authors>urattems</Authors>
    <Product>Maquereaux</Product>
    <Copyright>© 2026 urattems</Copyright>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
