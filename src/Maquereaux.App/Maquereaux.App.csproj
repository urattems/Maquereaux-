<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Uniquement pour NotifyIcon (icône de la zone de notification) : WPF n'en a pas -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFAC010 : l'analyseur WinForms veut le DPI hors du manifest ; c'est une appli WPF, le manifest est la bonne place -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <RootNamespace>Maquereaux.App</RootNamespace>
    <AssemblyName>Maquereaux</AssemblyName>
    <ApplicationIcon>..\..\assets\maquereaux.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Publication : un seul .exe autonome (aucun .NET à installer sur le PC cible) -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Embarque aussi les DLL natives de WPF (sinon elles restent à côté de l'exe) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compression : ~150 Mo → ~65 Mo, au prix d'un démarrage un poil plus lent -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Les "implicit usings" WPF n'incluent pas System.IO -->
    <Using Include="System.IO" />
    <!-- WinForms n'est utilisé que pour la NotifyIcon : on évite les conflits de noms (Application, MessageBox…) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\maquereaux.ico" Link="Assets\maquereaux.ico" />
    <!-- Polices embarquées (SIL OFL 1.1) : rendu identique sur tous les PC -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- MVVM : [ObservableProperty]/[RelayCommand] générés à la compilation → zéro boilerplate INotifyPropertyChanged -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <!-- Logs : API standard .NET ; le fournisseur "fichier" est maison (40 lignes, pas besoin de Serilog) -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maquereaux.Core\Maquereaux.Core.csproj" />
    <ProjectReference Include="..\Maquereaux.Win32\Maquereaux.Win32.csproj" />
  </ItemGroup>

</Project>
