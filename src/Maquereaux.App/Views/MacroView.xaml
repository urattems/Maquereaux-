<UserControl x:Class="Maquereaux.App.Views.MacroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Maquereaux.App.ViewModels"
             xmlns:controls="clr-namespace:Maquereaux.App.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}" d:DesignWidth="980" d:DesignHeight="560">
    <Grid DataContext="{Binding ActiveProfile}" d:DataContext="{d:DesignInstance vm:ProfileViewModel}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="380" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="2*" MinWidth="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Séquence ===== -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Tout effacer" Style="{StaticResource Button.Icon}"
                            Command="{Binding ClearStepsCommand}" ToolTip="Supprimer toutes les touches" />
                    <TextBlock Text="Séquence" Style="{StaticResource Text.Title}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>

                <controls:KeyCaptureBox x:Name="AddKeyBox" DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,8"
                                        Placeholder="+  Ajouter une touche : clique ici puis appuie sur la touche"
                                        KeyCapturedCommand="{Binding AddStepCommand}" FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.Accent}" />

                <Grid DockPanel.Dock="Top" Margin="8,0,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="#" Style="{StaticResource Text.Muted}" />
                    <TextBlock Grid.Column="1" Text="Touche (clic pour changer)" Style="{StaticResource Text.Muted}" />
                    <TextBlock Grid.Column="2" Text="Appui (ms)" Style="{StaticResource Text.Muted}"
                               ToolTip="Durée entre l'appui et le relâchement. 0 = instantané (le plus précis). Monte à 5–20 ms si une appli rate des appuis." />
                    <TextBlock Grid.Column="3" Text="Délai après (ms)" Style="{StaticResource Text.Muted}"
                               ToolTip="Mode Cycle uniquement. Vide = intervalle global." />
                </Grid>

                <Grid>
                    <ListBox x:Name="StepsList" ItemsSource="{Binding Steps}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StepViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="96" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Index}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"
                                               FontFamily="{StaticResource Font.Mono}" />
                                    <controls:KeyCaptureBox Grid.Column="1" Key="{Binding Key}" Margin="0,0,10,0" FontWeight="SemiBold"
                                                            ToolTip="Clique puis appuie sur une autre touche pour la remplacer" />
                                    <TextBox Grid.Column="2" Style="{StaticResource TextBox.Number}" HorizontalAlignment="Left"
                                             Text="{Binding HoldMs, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                                    <TextBox Grid.Column="3" Style="{StaticResource TextBox.Number}" HorizontalAlignment="Left"
                                             Text="{Binding DelayAfterMs, UpdateSourceTrigger=LostFocus, TargetNullValue='', ValidatesOnExceptions=True}" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="▲" Style="{StaticResource Button.Icon}" ToolTip="Monter"
                                                Command="{Binding DataContext.MoveStepUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        <Button Content="▼" Style="{StaticResource Button.Icon}" ToolTip="Descendre"
                                                Command="{Binding DataContext.MoveStepDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                        <Button Content="✕" Style="{StaticResource Button.Icon}" ToolTip="Supprimer"
                                                Command="{Binding DataContext.RemoveStepCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Séquence vide : ajoute une touche ci-dessous." HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}"
                               Visibility="{Binding HasSteps, Converter={StaticResource BoolToVisInverted}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- ===== Réglages du profil ===== -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Réglages" Style="{StaticResource Text.Title}" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Nom" Style="{StaticResource Text.Label}" />
                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Margin="0,3" />

                        <TextBlock Grid.Row="1" Text="Intervalle (ms)" Style="{StaticResource Text.Label}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                            <TextBox Style="{StaticResource TextBox.Number}"
                                     Text="{Binding IntervalMs, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                     ToolTip="Temps entre deux ticks. Minimum 1 ms." />
                            <TextBlock Text="min 1 ms" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Répétitions" Style="{StaticResource Text.Label}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                            <TextBox Style="{StaticResource TextBox.Number}"
                                     Text="{Binding RepeatCount, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                                     ToolTip="Nombre de cycles complets. 0 = infini." />
                            <TextBlock Text="0 = infini" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="3" Text="Raccourci ON/OFF" Style="{StaticResource Text.Label}" />
                        <controls:HotkeyBox Grid.Row="3" Grid.Column="1" Hotkey="{Binding Hotkey}" Margin="0,3"
                                            ToolTip="Clique puis appuie sur la combinaison. Retour arrière = aucun." />
                    </Grid>

                    <TextBlock Text="Mode d'envoi" Style="{StaticResource Text.Label}" Margin="0,4,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton GroupName="SeqMode" Content="Cycle"
                                     IsChecked="{Binding SequenceMode, Converter={StaticResource EnumToBool}, ConverterParameter=Cycle}" />
                        <RadioButton GroupName="SeqMode" Content="Burst"
                                     IsChecked="{Binding SequenceMode, Converter={StaticResource EnumToBool}, ConverterParameter=Burst}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,10"
                               Text="Cycle : une touche par tick (A → Z → E → A…). Burst : toute la séquence à chaque tick (A,Z,E → A,Z,E…)." />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== Bas : compteur ===== -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10"
                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Ticks envoyés" Style="{StaticResource Text.Label}" />
                <TextBlock Text="{Binding TicksSent}" Style="{StaticResource Text.StatValue}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
