<Window x:Class="Maquereaux.App.Views.CompactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Maquereaux.App.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Maquereaux (compact)" Width="300" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Icon="/Assets/maquereaux.ico"
        FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Brush.Text}"
        MouseLeftButtonDown="OnDrag">
    <!-- Mini-fenêtre : déplaçable à la souris, toujours au premier plan -->
    <Border CornerRadius="10" Padding="12,10" BorderThickness="2"
            Style="{StaticResource State.Border}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="16" Height="16" Style="{StaticResource State.Dot}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding EngineState, Converter={StaticResource StateToText}}" FontSize="20"
                           Style="{StaticResource State.Text}" />
                <TextBlock Text="{Binding ActiveProfile.Name}" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{Binding StartStopLabel}" Command="{Binding StartStopCommand}" Padding="8,4" Margin="0,0,6,0" />
                <Button Content="⤢" Command="{Binding ToggleCompactCommand}" Style="{StaticResource Button.Icon}" ToolTip="Revenir à la fenêtre complète" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
