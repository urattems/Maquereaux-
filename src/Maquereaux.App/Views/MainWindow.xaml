<Window x:Class="Maquereaux.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Maquereaux.App.ViewModels"
        xmlns:views="clr-namespace:Maquereaux.App.Views"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding Title}" Width="1040" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding AlwaysOnTop}"
        Icon="/Assets/maquereaux.ico"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <!-- ===== Bandeau d'état : énorme et coloré, lisible d'un coup d'œil ===== -->
        <Border DockPanel.Dock="Top" Margin="16,14,16,8" CornerRadius="10" Padding="20,12"
                Style="{StaticResource State.Border}" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="26" Height="26" Style="{StaticResource State.Dot}" Margin="0,0,14,0" />
                    <TextBlock x:Name="StatusText" Text="{Binding EngineState, Converter={StaticResource StateToText}}" FontSize="36"
                               Style="{StaticResource State.Text}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                    <TextBlock FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                        <Run Text="Profil :" Foreground="{DynamicResource Brush.TextMuted}" />
                        <Run Text="{Binding ActiveProfile.Name, Mode=OneWay}" />
                        <Run Text="  ·  " Foreground="{DynamicResource Brush.TextMuted}" />
                        <Run Text="{Binding ActiveProfile.HotkeyText, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent}" />
                    </TextBlock>
                    <TextBlock Text="{Binding LastStopInfo}" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" FontSize="12">
                        <Run Text="Arrêt d'urgence :" />
                        <Run Text="{Binding EmergencyHotkey, Mode=OneWay}" Foreground="{DynamicResource Brush.Stopped}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Compact" Command="{Binding ToggleCompactCommand}" Margin="0,0,8,0"
                            ToolTip="Mini-fenêtre toujours au premier plan (état + profil + START/STOP)" />
                    <ToggleButton IsChecked="{Binding AlwaysOnTop}" ToolTip="Toujours au premier plan" Margin="0,0,8,0" Content="Premier plan" />
                    <Button Command="{Binding StartStopCommand}" Content="{Binding StartStopLabel}" MinWidth="130" FontSize="16" Padding="16,10">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Accent}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Stopped}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stopped}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Notifications ===== -->
        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Notifications}" Margin="16,0,16,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NotificationViewModel}">
                    <Border CornerRadius="6" Padding="10,6" Margin="0,4,0,0" Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.Paused}" BorderThickness="1">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource Button.Icon}"
                                    Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Paused}" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Onglets ===== -->
        <TabControl x:Name="Tabs" Margin="16,0,16,8">
            <TabItem Header="Macro">
                <views:MacroView DataContext="{Binding}" Margin="0,10,0,0" />
            </TabItem>
            <TabItem Header="Profils">
                <views:ProfilesView DataContext="{Binding}" Margin="0,10,0,0" />
            </TabItem>
            <TabItem Header="Paramètres">
                <views:SettingsView DataContext="{Binding}" Margin="0,10,0,0" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
