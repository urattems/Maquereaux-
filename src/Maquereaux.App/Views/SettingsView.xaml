<UserControl x:Class="Maquereaux.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Maquereaux.App.ViewModels"
             xmlns:controls="clr-namespace:Maquereaux.App.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Sécurité" Style="{StaticResource Text.Title}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Arrêt d'urgence (global)" Style="{StaticResource Text.Label}" />
                        <controls:HotkeyBox Grid.Column="1" Hotkey="{Binding EmergencyHotkey}" AllowNone="False" />
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0"
                               Text="Toujours actif, même pendant la capture d'une touche. Il coupe la macro et relâche toutes les touches." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Précision du timer" Style="{StaticResource Text.Title}" />
                    <RadioButton GroupName="Timer" Margin="0,3" Content="Standard (Thread.Sleep) — référence imprécise, ~15,6 ms de granularité"
                                 IsChecked="{Binding TimerStrategy, Converter={StaticResource EnumToBool}, ConverterParameter=Standard}" />
                    <RadioButton GroupName="Timer" Margin="0,3" Content="Haute résolution — précis et économe (recommandé)"
                                 IsChecked="{Binding TimerStrategy, Converter={StaticResource EnumToBool}, ConverterParameter=HighResolution}" />
                    <RadioButton GroupName="Timer" Margin="0,3" Content="Hybride — haute résolution + attente active la dernière ms : le plus précis"
                                 IsChecked="{Binding TimerStrategy, Converter={StaticResource EnumToBool}, ConverterParameter=Hybrid}" />
                    <Border Margin="0,8,0,0" Padding="10,6" CornerRadius="6" Background="{DynamicResource Brush.PausedBg}"
                            Visibility="{Binding IsHybridTimer, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Paused}"
                                   Text="⚠ Le mode Hybride occupe un cœur CPU pendant la dernière milliseconde de chaque intervalle (≈ 10 % d'un cœur à 10 ms, beaucoup plus à 1–2 ms). Plus de chauffe et de conso sur portable." />
                    </Border>
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0"
                               Text="Pourquoi : Windows ne réveille les threads qu'à chaque « tic » d'horloge (~15,6 ms). Un Sleep(10) dure donc souvent ~15 ms. Le timer haute résolution contourne ce tic proprement. Changement pris en compte au prochain démarrage de la macro." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Garde-fou" Style="{StaticResource Text.Title}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Arrêt automatique après" Style="{StaticResource Text.Label}" />
                        <TextBox Style="{StaticResource TextBox.Number}" Width="60"
                                 Text="{Binding SafetyTimeoutMinutes, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                        <TextBlock Text="minutes (1 à 240)" Style="{StaticResource Text.Label}" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0"
                               Text="Une exécution s'arrête toute seule passé ce délai : Maquereaux est un outil de test et d'apprentissage, pas fait pour tourner sans surveillance." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Fenêtre &amp; apparence" Style="{StaticResource Text.Title}" />
                    <CheckBox Content="Toujours au premier plan" IsChecked="{Binding AlwaysOnTop}" />
                    <CheckBox Content="Réduire dans la zone de notification (à côté de l'horloge)" IsChecked="{Binding MinimizeToTray}" />
                    <CheckBox Content="Thème clair" IsChecked="{Binding IsLightTheme}" />
                    <Button Content="Mode compact" Command="{Binding ToggleCompactCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            ToolTip="Mini-fenêtre toujours au premier plan : état + profil actif + START/STOP" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Droits administrateur (UIPI)" Style="{StaticResource Text.Title}" />
                    <TextBlock Style="{StaticResource Text.Muted}"
                               Text="Windows interdit à une appli « normale » d'envoyer des touches à une appli lancée en administrateur. Si ta cible est en admin, relance Maquereaux en admin (sinon inutile)." />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Relancer en administrateur" Command="{Binding RestartAsAdminCommand}"
                                IsEnabled="{Binding IsElevated, Converter={StaticResource InverseBool}}" />
                        <TextBlock Text="✔ Maquereaux tourne déjà en administrateur" Foreground="{DynamicResource Brush.Running}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Données" Style="{StaticResource Text.Title}" />
                    <TextBlock Style="{StaticResource Text.Muted}">
                        <Run Text="Profils, réglages et logs (100 % local, aucune connexion réseau) :" />
                        <Run Text="{Binding DataDir, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                    </TextBlock>
                    <Button Content="Ouvrir le dossier" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
