<UserControl x:Class="Maquereaux.App.Controls.ProcessPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Maquereaux.App.Controls"
             xmlns:svc="clr-namespace:Maquereaux.App.Services"
             Focusable="False">
    <!-- Sélecteur de fenêtre cible : bouton (icône + nom) qui ouvre une liste des applis ouvertes avec recherche -->
    <Grid>
        <ToggleButton x:Name="Toggle" MinHeight="{DynamicResource Control.Height}" Cursor="Hand" FocusVisualStyle="{StaticResource Focus.Ring}"
                      AutomationProperties.Name="Choisir la fenêtre cible"
                      IsHitTestVisible="{Binding IsOpen, ElementName=Popup, Converter={StaticResource InverseBool}}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{DynamicResource Surface.Sunken}" BorderBrush="{DynamicResource Border.Default}"
                            BorderThickness="1" CornerRadius="{DynamicResource Radius.M}" Padding="10,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <DockPanel>
                <c:Icon DockPanel.Dock="Right" Glyph="{StaticResource Icon.ChevronDown}" Width="12" Height="12" Foreground="{DynamicResource Text.Secondary}" />
                <Grid Width="16" Height="16" Margin="0,0,10,0">
                    <c:Icon x:Name="CurrentGlyph" Glyph="{StaticResource Icon.Window}" Foreground="{DynamicResource Text.Secondary}" />
                    <Image x:Name="CurrentIcon" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <TextBlock x:Name="CurrentText" Text="Toutes les fenêtres" Foreground="{DynamicResource Text.Primary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </ToggleButton>

        <Popup x:Name="Popup" IsOpen="{Binding IsChecked, ElementName=Toggle}" PlacementTarget="{Binding ElementName=Toggle}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Style="{StaticResource Card.Elevated}" Margin="8,4,8,16" Padding="8" Width="360">
                <StackPanel>
                    <TextBox x:Name="Search" c:Ui.Placeholder="Rechercher, ou taper un nom d'exe puis Entrée"
                             AutomationProperties.Name="Rechercher une appli" />
                    <Grid Margin="0,8,0,0" MinHeight="64">
                        <ListBox x:Name="List" MaxHeight="300" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Applis ouvertes">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Margin" Value="0,0,0,2" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:ProcessEntry}">
                                    <DockPanel>
                                        <Grid Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <c:Icon Glyph="{StaticResource Icon.Window}" Width="18" Height="18" Foreground="{DynamicResource Text.Tertiary}"
                                                    Visibility="{Binding Icon, Converter={StaticResource NullToVisInverted}}" />
                                            <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" Foreground="{DynamicResource Text.Primary}" />
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasTitle, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <!-- États : chargement / aucun résultat -->
                        <TextBlock x:Name="Loading" Text="Recherche des applis ouvertes…" Style="{StaticResource Text.Caption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        <StackPanel x:Name="NoResult" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Aucune appli ouverte ne correspond" Style="{StaticResource Text.BodyStrong}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="NoResultHint" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                    <Separator Margin="0,6" />
                    <Button x:Name="AnyWindow" Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Left" c:Ui.Icon="{StaticResource Icon.Window}"
                            Content="Toutes les fenêtres (aucun filtre)" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
