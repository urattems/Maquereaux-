<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        🫧 Thème « Écume » (clair) : mêmes clés que Dark.xaml, à parité complète.
        Accent turquoise assombri pour garder un contraste AA sur fond blanc.
    -->

    <Color x:Key="Color.Base">#E9F1F7</Color>
    <Color x:Key="Color.Layer">#F3F8FB</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Accent">#077A70</Color>
    <Color x:Key="Color.AccentDeep">#0F6FA8</Color>
    <Color x:Key="Color.Silver">#8FA6BC</Color>
    <Color x:Key="Color.Running">#077A70</Color>
    <Color x:Key="Color.Paused">#B8780A</Color>
    <Color x:Key="Color.Danger">#D2463A</Color>
    <Color x:Key="Color.Shadow">#2E1A3550</Color>

    <SolidColorBrush x:Key="Bg.Base" Color="#E9F1F7" />
    <SolidColorBrush x:Key="Bg.BaseTint" Color="#D9E9F1F7" />
    <SolidColorBrush x:Key="Bg.Layer" Color="#F3F8FB" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface.Elevated" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface.Sunken" Color="#EEF4F9" />
    <SolidColorBrush x:Key="Surface.Hover" Color="#E4EEF6" />
    <SolidColorBrush x:Key="Surface.Pressed" Color="#D9E6F1" />
    <SolidColorBrush x:Key="Surface.Selected" Color="#D9F2EF" />
    <SolidColorBrush x:Key="Keycap.Face" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Keycap.Side" Color="#C9D8E5" />
    <SolidColorBrush x:Key="Keycap.Edge" Color="#B3C6D8" />

    <SolidColorBrush x:Key="Border.Subtle" Color="#E1EAF2" />
    <SolidColorBrush x:Key="Border.Default" Color="#CFDDE8" />
    <SolidColorBrush x:Key="Border.Strong" Color="#A9BFD3" />
    <SolidColorBrush x:Key="Border.Focus" Color="#077A70" />

    <SolidColorBrush x:Key="Text.Primary" Color="#0E1C2E" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#46607C" />
    <SolidColorBrush x:Key="Text.Tertiary" Color="#56708C" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#A3B4C6" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Accent" Color="#077A70" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#0CB0A2" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="#08857B" />
    <SolidColorBrush x:Key="Accent.Subtle" Color="#140B9C90" />
    <SolidColorBrush x:Key="Accent.Muted" Color="#2E0B9C90" />
    <LinearGradientBrush x:Key="Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#0F7FC0" />
        <GradientStop Offset="0.55" Color="#0B9C90" />
        <GradientStop Offset="1" Color="#12B5A6" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Signature.Gradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#0F6FA8" />
        <GradientStop Offset="0.45" Color="#8FA6BC" />
        <GradientStop Offset="1" Color="#0B9C90" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="State.Running" Color="#077A70" />
    <SolidColorBrush x:Key="State.Running.Bg" Color="#DDF4F1" />
    <SolidColorBrush x:Key="State.Running.Glow" Color="#550B9C90" />
    <SolidColorBrush x:Key="State.Stopped" Color="#5B728C" />
    <SolidColorBrush x:Key="State.Stopped.Bg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="State.Paused" Color="#9A5B00" />
    <SolidColorBrush x:Key="State.Paused.Bg" Color="#FCF0D9" />
    <SolidColorBrush x:Key="State.Danger" Color="#C93D31" />
    <SolidColorBrush x:Key="State.Danger.Bg" Color="#FBE4E1" />
    <SolidColorBrush x:Key="State.Danger.Hover" Color="#DE5246" />
    <SolidColorBrush x:Key="State.Info" Color="#1F6FCC" />
    <SolidColorBrush x:Key="State.Info.Bg" Color="#E3EFFC" />
    <SolidColorBrush x:Key="State.Success" Color="#077A70" />

    <SolidColorBrush x:Key="Source.Physical" Color="#1F6FCC" />
    <SolidColorBrush x:Key="Source.Maquereaux" Color="#0B9C90" />
    <SolidColorBrush x:Key="Source.Other" Color="#B8780A" />
    <SolidColorBrush x:Key="Chart.Grid" Color="#E1EAF2" />
    <SolidColorBrush x:Key="Chart.Band" Color="#1F0B9C90" />
    <SolidColorBrush x:Key="Chart.Target" Color="#46607C" />

    <SolidColorBrush x:Key="Caption.CloseHover" Color="#C42B1C" />
    <SolidColorBrush x:Key="Scrim" Color="#80E9F1F7" />

</ResourceDictionary>
