<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        Tokens indépendants du thème : typographie, grille d'espacement (4/8 px), rayons, élévations, durées.
        Règle : aucune valeur « magique » dans les vues, uniquement ces clés.
    -->

    <!-- ===== Polices embarquées (licence SIL OFL 1.1) ===== -->
    <FontFamily x:Key="Font.UI">pack://application:,,,/Assets/Fonts/#Inter</FontFamily>
    <!-- Chiffres tabulaires (monospace) : les nombres qui bougent ne « dansent » jamais -->
    <FontFamily x:Key="Font.Mono">pack://application:,,,/Assets/Fonts/#JetBrains Mono</FontFamily>
    <FontFamily x:Key="Font.System">Segoe UI</FontFamily>

    <!-- ===== Échelle typographique (6 tailles) ===== -->
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">16</sys:Double>
    <sys:Double x:Key="FontSize.Title">20</sys:Double>
    <sys:Double x:Key="FontSize.Headline">28</sys:Double>
    <sys:Double x:Key="FontSize.Display">40</sys:Double>

    <!-- ===== Espacements (grille de 4 px) ===== -->
    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.5">20</sys:Double>
    <sys:Double x:Key="Space.6">24</sys:Double>
    <sys:Double x:Key="Space.8">32</sys:Double>

    <Thickness x:Key="Pad.Page">32,24,32,24</Thickness>
    <Thickness x:Key="Pad.Card">20</Thickness>
    <Thickness x:Key="Pad.CardCompact">16,12,16,12</Thickness>
    <Thickness x:Key="Pad.Control">12,6,12,6</Thickness>
    <Thickness x:Key="Pad.Input">10,6,10,6</Thickness>
    <Thickness x:Key="Gap.Stack">0,0,0,16</Thickness>
    <Thickness x:Key="Gap.StackSmall">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.StackTiny">0,0,0,4</Thickness>
    <Thickness x:Key="Gap.Inline">0,0,8,0</Thickness>
    <Thickness x:Key="Gap.InlineSmall">0,0,4,0</Thickness>
    <Thickness x:Key="Gap.InlineLarge">0,0,16,0</Thickness>
    <Thickness x:Key="Gap.Top">0,8,0,0</Thickness>
    <Thickness x:Key="Gap.TopLarge">0,16,0,0</Thickness>

    <!-- ===== Rayons ===== -->
    <CornerRadius x:Key="Radius.S">4</CornerRadius>
    <CornerRadius x:Key="Radius.M">8</CornerRadius>
    <CornerRadius x:Key="Radius.L">12</CornerRadius>
    <CornerRadius x:Key="Radius.XL">16</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- ===== Tailles de contrôles ===== -->
    <sys:Double x:Key="Control.Height">32</sys:Double>
    <sys:Double x:Key="Control.HeightLarge">40</sys:Double>
    <sys:Double x:Key="Icon.Size">16</sys:Double>
    <sys:Double x:Key="Icon.SizeLarge">20</sys:Double>

    <!-- ===== Durées d'animation (150–250 ms, ease-out) ===== -->
    <Duration x:Key="Dur.Fast">0:0:0.15</Duration>
    <Duration x:Key="Dur.Normal">0:0:0.2</Duration>
    <Duration x:Key="Dur.Slow">0:0:0.25</Duration>
    <CubicEase x:Key="Ease.Out" EasingMode="EaseOut" />

    <!-- ===== Élévations (ombres) ===== -->
    <DropShadowEffect x:Shared="False" x:Key="Elevation.1" BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.28" Color="#000814" />
    <DropShadowEffect x:Shared="False" x:Key="Elevation.2" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#000814" />
    <DropShadowEffect x:Shared="False" x:Key="Elevation.3" BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.45" Color="#000814" />
</ResourceDictionary>
