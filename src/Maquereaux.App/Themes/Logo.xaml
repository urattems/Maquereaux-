<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ===== Logo Maquereaux (dessin maison, grille 24×24) ===== -->
    <Geometry x:Key="Logo.Body">F1 M 4 12 C 7 7.4 12 6.1 16.6 7.7 C 19.1 8.6 21.1 10.1 22.2 12 C 21.1 13.9 19.1 15.4 16.6 16.3 C 12 17.9 7 16.6 4 12 Z M 4.8 12 L 1 7.8 Q 2.3 12 1 16.2 Z</Geometry>
    <Geometry x:Key="Logo.Stripes">M 8 9.6 Q 8.9 10.4 8.1 11.3 M 10.6 8.7 Q 11.6 9.7 10.7 10.8 M 13.2 8.3 Q 14.2 9.4 13.3 10.5 M 15.8 8.4 Q 16.7 9.5 15.9 10.5</Geometry>
    <Geometry x:Key="Logo.Belly">F1 M 5.5 12.6 C 8.5 15.6 13.5 16.6 17.5 15.3 C 19.3 14.7 20.7 13.7 21.6 12.6 Z</Geometry>
    <EllipseGeometry x:Key="Logo.Eye" Center="18.7,11.2" RadiusX="0.95" RadiusY="0.95" />

    <!-- Logo composé, réutilisable partout : corps en dégradé signature, ventre argenté, rayures du dos, œil -->
    <DataTemplate x:Key="Logo">
        <Viewbox Stretch="Uniform">
            <Canvas Width="24" Height="24">
                <Path Data="{StaticResource Logo.Body}" Fill="{DynamicResource Signature.Gradient}" />
                <Path Data="{StaticResource Logo.Belly}" Fill="#55FFFFFF" />
                <Path Data="{StaticResource Logo.Stripes}" Stroke="#0B2340" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Path Data="{StaticResource Logo.Eye}" Fill="#0B2340" />
            </Canvas>
        </Viewbox>
    </DataTemplate>
</ResourceDictionary>
