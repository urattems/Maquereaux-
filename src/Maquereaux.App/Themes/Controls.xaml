<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Maquereaux.App.Controls">
    <!--
        Contrôles du design system Maquereaux. Chaque contrôle gère : normal, survol, pressé, focus clavier,
        désactivé (et erreur pour les champs). Les états « forcés » (c:Ui.ForceHover…) servent à la galerie
        de captures et au bouton Agrandir (Snap Layouts).
    -->

    <!-- ===== Focus clavier : anneau turquoise arrondi, décalé de 3 px ===== -->
    <Style x:Key="Focus.Ring">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Border.Focus}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Icône : c:Icon se dessine seule (Controls/Ui.cs), aucun style requis ===== -->

    <!-- ================================================================
         BOUTONS : Secondaire (défaut), Primaire, Fantôme, Danger, Icône seule
         ================================================================ -->
    <ControlTemplate x:Key="Btn.Template" TargetType="ButtonBase">
        <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.M}" SnapsToDevicePixels="True" />
            <!-- Voile de survol/pression : évite de dupliquer les couleurs pour chaque variante -->
            <Border x:Name="Veil" CornerRadius="{DynamicResource Radius.M}" Background="{TemplateBinding Foreground}" Opacity="0" />
            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <c:Icon x:Name="Ico" Glyph="{TemplateBinding c:Ui.Icon}" Width="16" Height="16" Foreground="{TemplateBinding Foreground}" Margin="0,0,8,0" />
                <ContentPresenter x:Name="Content" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="c:Ui.Icon" Value="{x:Null}">
                <Setter TargetName="Ico" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="Ico" Property="Margin" Value="0" />
                <Setter TargetName="Content" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Veil" Property="Opacity" Value="0.07" />
            </Trigger>
            <Trigger Property="c:Ui.ForceHover" Value="True">
                <Setter TargetName="Veil" Property="Opacity" Value="0.07" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Veil" Property="Opacity" Value="0.14" />
            </Trigger>
            <Trigger Property="c:Ui.ForcePressed" Value="True">
                <Setter TargetName="Veil" Property="Opacity" Value="0.14" />
            </Trigger>
            <Trigger Property="c:Ui.ForceFocus" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border.Focus}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Btn.Base" TargetType="ButtonBase">
        <Setter Property="Template" Value="{StaticResource Btn.Template}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.Height}" />
        <Setter Property="Padding" Value="{DynamicResource Pad.Control}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    </Style>

    <!-- Secondaire : le bouton par défaut -->
    <Style x:Key="Btn.Secondary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Btn.Secondary}" />

    <!-- Primaire : dégradé signature, réservé à l'action principale d'un écran -->
    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource Accent.Gradient}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Fantôme : action discrète (barres d'outils, actions secondaires) -->
    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <!-- Danger : actions destructrices -->
    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource State.Danger.Bg}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource State.Danger}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Icône seule (carré 32×32) : toujours accompagné d'un ToolTip + AutomationProperties.Name -->
    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>

    <!-- Puce (preset, filtre) -->
    <Style x:Key="Btn.Chip" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,2" />
    </Style>

    <!-- Boutons de la barre de titre (46×40, comme Windows 11) -->
    <Style x:Key="Btn.Caption" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Veil" Background="{TemplateBinding Foreground}" Opacity="0" />
                        <c:Icon Glyph="{TemplateBinding c:Ui.Icon}" Width="16" Height="16" Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="c:Ui.ForceHover" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0.04" />
                        </Trigger>
                        <Trigger Property="c:Ui.ForcePressed" Value="True">
                            <Setter TargetName="Veil" Property="Opacity" Value="0.04" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Btn.CaptionClose" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Caption.CloseHover}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ToggleButton (ex. épingler) -->
    <Style TargetType="ToggleButton" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Accent.Subtle}" />
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Puce à bascule (ouvre un petit éditeur en popup : durée d'appui, délai) -->
    <Style x:Key="Chip.Toggle" TargetType="ToggleButton" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="Padding" Value="7,1" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource Accent.Subtle}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================
         CHAMPS DE SAISIE
         ================================================================ -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Primary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource Pad.Input}" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.Height}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate">
            <Setter.Value>
                <ControlTemplate>
                    <AdornedElementPlaceholder />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource Radius.M}" SnapsToDevicePixels="True" />
                        <!-- Liseré bas « actif » à la Windows 11 -->
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="0,0,8,8"
                                Background="{DynamicResource Accent}" Opacity="0" />
                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding c:Ui.Placeholder}" Margin="{TemplateBinding Padding}"
                                   Foreground="{DynamicResource Text.Tertiary}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   IsHitTestVisible="False" Visibility="Collapsed" Padding="2,0,0,0" TextTrimming="CharacterEllipsis" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
                        </Trigger>
                        <Trigger Property="c:Ui.ForceHover" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}" />
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="c:Ui.ForceFocus" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}" />
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource State.Danger}" />
                        </Trigger>
                        <Trigger Property="c:Ui.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource State.Danger}" />
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource State.Danger}" />
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="ToolTip" Value="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Petits boutons ▲▼ du champ numérique -->
    <Style x:Key="Btn.Spin" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Delay" Value="350" />
        <Setter Property="Interval" Value="60" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Tertiary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Radius.S}">
                        <c:Icon Glyph="{TemplateBinding c:Ui.Icon}" Width="10" Height="10" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:NumericBox">
        <Setter Property="MinHeight" Value="{DynamicResource Control.Height}" />
        <Setter Property="Width" Value="112" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:NumericBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{DynamicResource Surface.Sunken}" BorderBrush="{DynamicResource Border.Default}"
                                BorderThickness="1" CornerRadius="{DynamicResource Radius.M}" SnapsToDevicePixels="True" />
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="0,0,8,8"
                                Background="{DynamicResource Accent}" Opacity="0" />
                        <Grid Margin="2,0,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PART_Text" Background="Transparent" BorderThickness="0" Padding="8,0,2,0"
                                     FontFamily="{DynamicResource Font.Mono}" Foreground="{TemplateBinding Foreground}"
                                     HorizontalContentAlignment="Right" c:Ui.Placeholder="{TemplateBinding EmptyText}"
                                     AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <TextBlock x:Name="Ph" Text="{TemplateBinding c:Ui.Placeholder}" Foreground="{DynamicResource Text.Tertiary}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed"
                                                       FontFamily="{DynamicResource Font.UI}" FontStyle="Italic" />
                                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"
                                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="Text" Value="" />
                                                    <Condition Property="IsKeyboardFocused" Value="False" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Ph" Property="Visibility" Value="Visible" />
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Unit}" Foreground="{DynamicResource Text.Tertiary}"
                                       VerticalAlignment="Center" Margin="2,0,6,0" FontSize="{DynamicResource FontSize.Caption}" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,2,0">
                                <RepeatButton x:Name="PART_Up" Style="{StaticResource Btn.Spin}" Height="13" c:Ui.Icon="{DynamicResource Icon.ChevronDown}"
                                              RenderTransformOrigin="0.5,0.5" ToolTip="Augmenter (molette, ↑)">
                                    <RepeatButton.RenderTransform>
                                        <ScaleTransform ScaleY="-1" />
                                    </RepeatButton.RenderTransform>
                                </RepeatButton>
                                <RepeatButton x:Name="PART_Down" Style="{StaticResource Btn.Spin}" Height="13" c:Ui.Icon="{DynamicResource Icon.ChevronDown}"
                                              ToolTip="Diminuer (molette, ↓)" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}" />
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="c:Ui.ForceFocus" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface}" />
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsInvalid" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource State.Danger}" />
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource State.Danger}" />
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="c:Ui.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource State.Danger}" />
                            <Setter TargetName="Underline" Property="Background" Value="{DynamicResource State.Danger}" />
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         COMBOBOX
         ================================================================ -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource Radius.S}" Margin="4,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="MinHeight" Value="{DynamicResource Control.Height}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="{DynamicResource Surface.Sunken}" BorderBrush="{DynamicResource Border.Default}"
                                            BorderThickness="1" CornerRadius="{DynamicResource Radius.M}">
                                        <c:Icon Glyph="{DynamicResource Icon.ChevronDown}" Width="12" Height="12" HorizontalAlignment="Right"
                                                Margin="0,0,10,0" Foreground="{DynamicResource Text.Secondary}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border.Strong}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Content" IsHitTestVisible="False" Margin="10,4,30,4" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed" Margin="1,1,26,1" Background="Transparent"
                                 BorderThickness="0" IsReadOnly="{TemplateBinding IsReadOnly}" c:Ui.Placeholder="{TemplateBinding c:Ui.Placeholder}" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" VerticalOffset="4">
                            <Border Background="{DynamicResource Surface.Elevated}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.M}" Padding="0,4" Margin="8,0,8,12"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Effect="{DynamicResource Elevation.2}">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Content" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         CASE À COCHER + INTERRUPTEUR (toggle switch)
         ================================================================ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="{DynamicResource Radius.S}" BorderThickness="1.5" VerticalAlignment="Center"
                                Background="{DynamicResource Surface.Sunken}" BorderBrush="{DynamicResource Border.Strong}">
                            <c:Icon x:Name="Check" Glyph="{DynamicResource Icon.Check}" Width="14" Height="14" Foreground="{DynamicResource Text.OnAccent}" Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Interrupteur ON/OFF : à utiliser pour tout réglage binaire qui s'applique immédiatement -->
    <Style x:Key="Toggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="40" Height="22" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="11" BorderThickness="1.5" Background="{DynamicResource Surface.Sunken}" BorderBrush="{DynamicResource Border.Strong}" />
                            <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="5,0,0,0" Fill="{DynamicResource Text.Secondary}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbX" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbX" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Text.OnAccent}" />
                            <Setter TargetName="Thumb" Property="Width" Value="14" />
                            <Setter TargetName="Thumb" Property="Height" Value="14" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="c:Ui.ForceHover" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         RADIO + CONTRÔLE SEGMENTÉ
         ================================================================ -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" StrokeThickness="1.5" Fill="{DynamicResource Surface.Sunken}" Stroke="{DynamicResource Border.Strong}" />
                            <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hôte du contrôle segmenté : <Border Style="{StaticResource Segmented}"><UniformGrid Rows="1"> + RadioButton Style="Segment" -->
    <Style x:Key="Segmented" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.M}" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <c:Icon x:Name="Ico" Glyph="{TemplateBinding c:Ui.Icon}" Width="14" Height="14" Margin="0,0,6,0" Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.Icon" Value="{x:Null}">
                            <Setter TargetName="Ico" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.Elevated}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Border.Default}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================
         SLIDER
         ================================================================ -->
    <Style x:Key="Slider.Thumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="20" Height="20">
                        <Ellipse Fill="{DynamicResource Surface.Elevated}" Stroke="{DynamicResource Border.Strong}" StrokeThickness="1" />
                        <Ellipse x:Name="Core" Width="10" Height="10" Fill="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="CoreScale" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Core" Property="Width" Value="12" />
                            <Setter TargetName="Core" Property="Height" Value="12" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Core" Property="Width" Value="8" />
                            <Setter TargetName="Core" Property="Height" Value="8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Slider.Fill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Slider.Fill}" Background="{DynamicResource Accent}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Slider.Fill}" Background="{DynamicResource Border.Default}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Slider.Thumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Clés de style v1.0 encore utilisées par les écrans pas encore refondus, remappées sur le nouveau design system.
        À supprimer à la fin de la refonte (U5).
    -->
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="Text.Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    </Style>
    <Style x:Key="Text.StatValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>
    <Style x:Key="Button.Accent" TargetType="Button" BasedOn="{StaticResource Btn.Primary}" />
    <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Danger}" />
    <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>
    <Style x:Key="TextBox.Number" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="80" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
    </Style>
</ResourceDictionary>
